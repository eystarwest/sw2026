{
  "name": "ecommerce-checkout-api",
  "version": "1.0.0",
  "description": "REST API for e-commerce login and checkout with JWT authentication",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:path-coverage",
    "test:path-coverage": "mocha --config test/pathCoverage/.mocharc.json",
    "test:load-login": "k6 run test/loadTesting/login.load.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "supertest": "^6.3.4"
  }
}
